{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self \"https://mus-api.vercel.app\")"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://mus-api.vercel.app"
        }
      ]
    }
  ]
}
